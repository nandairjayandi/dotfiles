#!/bin/sh

. "{{- .chezmoi.sourceDir -}}/dot_local/bin/install-helper.sh"

if [ "$(detect_os)" = "windows" ]; then
    print_error "Windows is not supported. Use WSL2 instead."
    exit 1
fi

if ! [ -w "$HOME" ]; then
    print_error "\$HOME ($HOME) is not writable. Cannot install Nix."
    exit 1
fi

if command_exists "nix"; then
    print_info "Nix already installed, skipping installation"
    exit 0
fi

check_nix_deps() {
    missing=""
    for cmd in curl tar xz; do
        if ! command_exists "$cmd"; then
            missing="$missing $cmd"
        fi
    done

    if [ -n "$missing" ] && ! is_root; then
        print_error "Missing required tools:$missing"
        print_error "Cannot install these without root. Ask your sysadmin or try another machine."
        return 1
    fi

    print_info "All Nix dependencies satisfied (curl, tar, xz found)."
}

prepare_nix_as_root() {
    pax_manager=$(detect_pax_manager)
    PATH="/usr/bin:/bin:$PATH"

    print_info "Installing Nix prerequisites via $pax_manager..."

    case "$pax_manager" in
        apt)
            install_package -y xz-utils curl tar bash passwd coreutils
            ;;
        apk)
            print_info "Alpine detected — Nix daemon mode unreliable on musl. Single-user will be forced."
            install_package -y doas xz curl tar bash shadow coreutils
            ;;
        dnf|yum)
            install_package -y xz curl tar bash shadow-utils coreutils
            ;;
        pacman)
            install_package -y xz curl tar bash shadow coreutils
            ;;
        brew)
            install_package xz coreutils
            ;;
        *)
            print_error "Unsupported package manager: $pax_manager"
            return 1
            ;;
    esac
}

install_nix() {
    if command_exists "nix"; then
        print_info "Nix is already installed ($(nix --version)). Skipping."
        return 0
    fi

    os=$(detect_os)
    pax_manager=$(detect_pax_manager)

    # Add temporarily right before the if is_root; then block
    print_info "DEBUG: whoami=$(id -un) uid=$(id -u) is_root=$(is_root && echo YES || echo NO) os=$(detect_os) pax=$(detect_pax_manager)"

    case "$os" in
        macos)
            # macOS requires multi-user; installer handles sudo internally
            print_info "Installing Nix (macOS, multi-user)..."
            curl --proto '=https' --tlsv1.2 -sSfL https://nixos.org/nix/install | sh
            ;;
        *)
            if is_root; then
                # Linux + root → MUST use --daemon, single-user explicitly unsupported as root
                print_info "Installing Nix (Linux, root, multi-user daemon)..."
                curl --proto '=https' --tlsv1.2 -sSfL https://nixos.org/nix/install | sh -s -- --daemon
            else
                # No root → single-user into $HOME
                print_info "Installing Nix (Linux, no root, single-user)..."
                curl --proto '=https' --tlsv1.2 -sSfL https://nixos.org/nix/install | sh -s -- --no-daemon
            fi
            ;;
    esac
}

source_nix() {
    # The installer drops a profile script we need to source before using nix
    if [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
        print_info "Sourcing single-user path"
        . "$HOME/.nix-profile/etc/profile.d/nix.sh"
    elif [ -e "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh" ]; then
        print_info "Sourcing Multi-user path"
        . "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
    else
        print_error "Could not find Nix profile script. Something went wrong with the install."
        exit 1
    fi
}

ensure_zsh() {
    if command_exists "zsh"; then
        print_info "zsh already available at $(command -v zsh)."
        return 0
    fi

    print_info "zsh not found — installing via Nix..."
    nix-env -iA nixpkgs.zsh

    if ! command_exists "zsh"; then
        print_error "zsh installation via Nix failed."
        exit 1
    fi

    print_info "zsh installed at $(command -v zsh)."
}

if is_root; then
    prepare_nix_as_root || exit 1
else
    check_nix_deps      || exit 1
fi

install_nix  || exit 1
source_nix   || exit 1
ensure_zsh   || exit 1

exec zsh